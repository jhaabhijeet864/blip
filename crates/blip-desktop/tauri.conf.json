{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blip",
  "version": "0.2.0",
  "identifier": "com.abhijeet.blip",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Blip Studio — Gesture Virtual Camera",
        "width": 1120,
        "height": 680,
        "minWidth": 960,
        "minHeight": 540,
        "center": true,
        "resizable": true,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

